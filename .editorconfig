root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,conf}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
